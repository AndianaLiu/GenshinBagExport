<Window x:Class="GenshinBagExport.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Genshin Bag Export v7.1.0" Icon="pack://application:,,,/GenshinBagExport-v7.1.0;component/Assets/Keqing.ico" Width="1160" Height="800" MinWidth="960" MinHeight="650" Background="#F3F5F9" FontFamily="Microsoft YaHei UI" Foreground="#202B3D" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <SolidColorBrush x:Key="Accent" Color="#4668D9"/>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="18,11"/><Setter Property="FontSize" Value="13"/><Setter Property="Background" Value="White"/>
   <Setter Property="Foreground" Value="#35435A"/><Setter Property="BorderBrush" Value="#DCE2ED"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.8"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.65"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.4"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#4668D9"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Padding" Value="12,10"/><Setter Property="FontSize" Value="13"/><Setter Property="Background" Value="#F8FAFD"/><Setter Property="BorderBrush" Value="#DCE2ED"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="SelectionBrush" Value="#A6B9F2"/>
  </Style>
  <Style TargetType="DataGridColumnHeader">
   <Setter Property="Background" Value="#F5F7FB"/><Setter Property="Foreground" Value="#64748B"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Padding" Value="16,14"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#E8EDF4"/>
  </Style>
  <Style TargetType="DataGridCell">
   <Setter Property="Padding" Value="16,10"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell">
    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center"/></Border>
   </ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#E7EDFF"/><Setter Property="Foreground" Value="#243A76"/></Trigger></Style.Triggers>
  </Style>
 </Window.Resources>
 <Grid Margin="28" Background="#F3F5F9">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,22">
   <StackPanel><TextBlock Text="原神背包导出" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="GENSHIN BAG EXPORT" FontSize="10" Foreground="#8A96A9" Margin="2,7,0,0" /></StackPanel>
   <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#E8EDF9" CornerRadius="12" Padding="13,8">
    <TextBlock Text="Genshin Impact 7.1.0 · TeyvatGuide 0.12.5" FontSize="12" Foreground="#50658E"/>
   </Border>
  </Grid>
  <Border Grid.Row="1" Background="White" CornerRadius="12" BorderBrush="#E4E9F2" BorderThickness="1" Padding="22" Margin="0,0,0,18">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="185"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="游戏路径" Foreground="#738097" FontSize="12" Margin="0,0,0,9"/>
    <Grid Grid.Row="1" Margin="0,0,20,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBox x:Name="GamePath" Text="" ToolTip="选择 Yuanshen.exe"/>
     <Button x:Name="BrowseButton" Grid.Column="1" Margin="8,0,0,0" Padding="13,10" Click="Browse_Click">选择游戏路径</Button>
    </Grid>
    <TextBlock Grid.Column="1" Text="存档 UID" Foreground="#738097" FontSize="12" Margin="0,0,0,9"/>
    <TextBox x:Name="UidInput" Grid.Column="1" Grid.Row="1" Text="" Margin="0,0,18,0"/>
    <Button x:Name="CaptureButton" Grid.Column="2" Grid.Row="1" Click="Capture_Click" Background="{StaticResource Accent}" BorderBrush="{StaticResource Accent}" Foreground="White" Padding="24,10">读取背包</Button>
   </Grid>
  </Border>
  <Border Grid.Row="2" CornerRadius="8" Background="#E9EFFC" Padding="14,11" Margin="0,0,0,18">
   <Border.Style><Style TargetType="Border"><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Status}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
   <StackPanel><TextBlock x:Name="Status" Text="" Foreground="#4D6085" FontSize="12" TextWrapping="Wrap"/><ProgressBar x:Name="BusyProgress" Visibility="Collapsed" IsIndeterminate="True" Height="3" Margin="0,10,0,0" BorderThickness="0" Foreground="#4668D9"/></StackPanel>
  </Border>
  <Border Grid.Row="3" Background="White" CornerRadius="12" BorderBrush="#E4E9F2" BorderThickness="1" Padding="0,18,0,10">
   <DockPanel>
    <Grid DockPanel.Dock="Top" Margin="20,0,20,16">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock Text="背包物品" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
      <ComboBox x:Name="Category" Width="195" Padding="8,6" SelectionChanged="Category_Changed" FontSize="12"/>
      <TextBlock x:Name="ItemCount" Text="0 种物品" FontSize="12" Foreground="#8A96A9" VerticalAlignment="Center" Margin="12,0,0,0"/>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal">
      <Button x:Name="ImportButton" Click="Import_Click" Padding="14,9">读取JSON</Button>
      <Button x:Name="ExportJsonButton" Click="ExportJson_Click" Padding="14,9" Margin="8,0,0,0" IsEnabled="False">导出JSON</Button>
      <Button x:Name="ExportButton" Click="Export_Click" Padding="14,9" Margin="8,0,0,0" IsEnabled="False">导出 Excel</Button>
     </StackPanel>
    </Grid>
    <DataGrid x:Name="Grid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserResizeRows="False" HeadersVisibility="Column" Background="White" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#F0F3F8" RowBackground="White" AlternatingRowBackground="#FBFCFE" RowHeaderWidth="0" SelectionMode="Single" FontSize="13">
     <DataGrid.Columns>
      <DataGridTextColumn Header="物品 ID" Binding="{Binding Id}" Width="110"/>
      <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*" MinWidth="140"/>
      <DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="180"/>
      <DataGridTextColumn Header="具体类型" Binding="{Binding Type}" Width="180"/>
      <DataGridTextColumn Header="星级" Binding="{Binding Star}" Width="75"/>
      <DataGridTextColumn Header="数量" Binding="{Binding Count, StringFormat=N0}" Width="110"/>
     </DataGrid.Columns>
    </DataGrid>
   </DockPanel>
  </Border>
 </Grid>
</Window>

